{
  "name": "octopus",
  "private": true,
  "version": "1.0.0",
  "description": "工具的瑞士军刀:一个扩展容纳多个工具。",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
