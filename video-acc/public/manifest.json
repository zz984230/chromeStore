{
  "manifest_version": 3,
  "name": "视频倍速助手",
  "version": "0.1.0",
  "description": "在任意网页调节视频播放档位：滑块与预设、保持记忆、跳过片头片尾、自动续播。",
  "author": "zhaor121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "视频倍速助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "pace-up": {
      "description": "加档（步进 0.25×）",
      "suggested_key": { "default": "Alt+Period" }
    },
    "pace-down": {
      "description": "减档（步进 0.25×）",
      "suggested_key": { "default": "Alt+Comma" }
    },
    "pace-normal": {
      "description": "回正到 1×",
      "suggested_key": { "default": "Alt+0" }
    },
    "hold-toggle": {
      "description": "切换保持（记忆当前档位并自动套用到新视频）",
      "suggested_key": { "default": "Alt+L" }
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
